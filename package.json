{
  "name": "kofevarka-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:clean": "docker compose down -v",
    "db:status": "node scripts/db-status.mjs",
    "db:wipe": "node scripts/reset-db.mjs",
    "db:directions": "node scripts/reset-directions.mjs",
    "db:partners": "node scripts/reset-partners.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:crypto": "node --experimental-strip-types --no-warnings api/_lib/selftest.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
