# Нормализация переводов строк.
# В рабочей копии всегда LF: Prettier настроен на endOfLine: "lf", а git на Windows
# по умолчанию (core.autocrlf=true) перезаписывает файлы в CRLF — после чего
# prettier --check начинает падать на каждом файле.
* text=auto eol=lf

# Исключение: скрипты для Windows обязаны быть в CRLF.
# cmd.exe не разбирает .cmd с переводами строк LF, а PowerShell 5.1 читает
# .ps1 в системной кодировке, поэтому файлы дополнительно держим в UTF-8 с BOM.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные файлы не трогаем
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
