# Pre-commit: сначала автоисправления по файлам из индекса, затем проверка типов.
# Если любая из команд упадёт — коммит не состоится.
set -e

# eslint --fix + prettier --write по изменённым файлам (см. lint-staged.config.js)
# Правки lint-staged сам добавляет в коммит.
npx --no-install lint-staged

# Типы проверяются по всему проекту: по одному файлу tsc не работает.
# tsc -b инкрементальный, поэтому повторные запуски быстрые.
npm run typecheck
