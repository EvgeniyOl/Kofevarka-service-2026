# Переменные окружения. Этот файл — образец: скопируйте его в .env.local
# и заполните.
#
# Локальная база в Docker (см. docker-compose.yml):
#   DATABASE_URL=postgresql://kofevarka:kofevarka@localhost:5433/kofevarka
#
# На Vercel те же переменные задаются в Settings → Environment Variables.
# Значения из .env.local в репозиторий не попадают — файл в .gitignore.

# Строка подключения к Postgres. Формат:
# postgresql://пользователь:пароль@хост:порт/база
# Для облачной базы добавьте ?sslmode=require — так требуют почти все провайдеры.
DATABASE_URL=

# Секрет для подписи сессионных cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Требование: не короче 16 символов. Без него в продакшене сервер откажется работать,
# потому что подпись была бы предсказуемой.
SESSION_SECRET=
