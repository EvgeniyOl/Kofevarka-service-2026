# Переменные окружения. Этот файл — образец: скопируйте его в .env.local
# и заполните. На Vercel те же значения задаются в Settings → Environment Variables
# (DATABASE_URL там появляется сам при подключении базы из Storage → Neon).

# Строка подключения к Postgres. Формат:
# postgresql://пользователь:пароль@хост/база?sslmode=require
DATABASE_URL=

# Секрет для подписи сессионных cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Требование: не короче 16 символов. Без него в продакшене сервер откажется работать,
# потому что подпись была бы предсказуемой.
SESSION_SECRET=
